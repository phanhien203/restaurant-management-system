# Local development defaults. Copy to `.env` in the repo root: `cp .env.example .env`.
# One root `.env` feeds Docker Compose (compose.dev.yml), apps/web and apps/realtime.
# Values here are throwaway local credentials, never real secrets. Do not commit `.env`.
# Env files are not interpolated by Node: if you change a *_PORT below, update the matching URL too.
# URLs use 127.0.0.1 (not localhost) because Compose binds ports to 127.0.0.1 only, and `localhost` may resolve to ::1.

# --- Runtime -------------------------------------------------------------------------------------------------
# Runtime mode for web and realtime: development | test | production (defaults to development if unset).
NODE_ENV=development

# --- PostgreSQL 17 (Compose-only; the apps read DATABASE_URL) -------------------------------------------------
# Database superuser created by the postgres container on first start.
POSTGRES_USER=rms
# Password of POSTGRES_USER (local only).
POSTGRES_PASSWORD=rms_local_password
# Database created on first start.
POSTGRES_DB=rms
# Host port mapped to the container's 5432; change if a local PostgreSQL already uses it.
POSTGRES_PORT=5432
# Connection string used by web (Prisma); built from the POSTGRES_* values above.
DATABASE_URL=postgresql://rms:rms_local_password@127.0.0.1:5432/rms?schema=public

# --- Redis 7 ----------------------------------------------------------------------------------------------
# Host port mapped to the container's 6379 (Compose-only); change if a local Redis already uses it.
REDIS_PORT=6379
# Connection string used by web (publish) and realtime (subscribe); must match REDIS_PORT.
REDIS_URL=redis://127.0.0.1:6379

# --- MinIO (S3-compatible object storage) --------------------------------------------------------------------
# Host port of the MinIO S3 API (Compose-only); must match S3_ENDPOINT.
MINIO_API_PORT=9000
# Host port of the MinIO web console, http://127.0.0.1:9001 (Compose-only).
MINIO_CONSOLE_PORT=9001
# S3 API endpoint used by web for uploads.
S3_ENDPOINT=http://127.0.0.1:9000
# S3 region; MinIO accepts any value, us-east-1 is its default.
S3_REGION=us-east-1
# Access key used by web; locally also the MinIO root user (min 3 chars).
S3_ACCESS_KEY_ID=rms-minio
# Secret key used by web; locally also the MinIO root password (min 8 chars).
S3_SECRET_ACCESS_KEY=rms-minio-local-secret
# Bucket for menu images and other uploads (created in US-11).
S3_BUCKET=rms-local

# --- Realtime service ----------------------------------------------------------------------------------------
# Port the Socket.IO server (apps/realtime) listens on; web runs on 3000.
REALTIME_PORT=3001
