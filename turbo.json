{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.node.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"],
      "outputs": []
    },
    "//#lint:root": {
      "inputs": ["*.{js,mjs,cjs,ts,mts,cts}", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": ["*.{js,mjs,cjs,ts,mts,cts}", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "S3_*", "REALTIME_PORT"]
    }
  }
}
